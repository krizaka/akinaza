# Akinaza — local development. Copy to .env; never commit .env.
APP_PUBLIC_URL=http://localhost:3000
# A database of your own (one per worktree/session), PostgreSQL 16.
DATABASE_URL=postgresql://akinaza:akinaza@localhost:5432/akinaza_dev
# LISTEN needs a direct connection (not a transaction pooler); defaults to DATABASE_URL.
DATABASE_DIRECT_URL=
REALTIME_BUS=postgres
AUTH_SESSION_SECRET=
AUTH_SIGNUP_ENABLED=false
AUTH_ALLOWED_IPS=
# Orazaka's edge and Akinaza's oz_ service key (the tax-assistant Studio runs there).
AI_API_URL=https://dev.orazaka.com/edge
AI_API_KEY=
# The point of sale stays off (SRM scope and payment provider undecided); never for a restaurant or a bar.
APP_POS_ENABLED=false
