<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- folioviv://app/… opens the same page of the back office in the window (tauri-plugin-krizaka turns it into a route). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.krizaka.folioviv.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>folioviv</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
