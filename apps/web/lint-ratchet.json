{
  "globs": [
    "app/**/*.tsx",
    "components/**/*.tsx",
    "src/**/*.tsx"
  ],
  "stackGlobs": [
    "app/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "components/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "src/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "lib/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "hooks/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "features/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "scripts/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "proxy.ts"
  ],
  "counters": {
    "palette": 0,
    "light": 0,
    "arbitraryVar": 0,
    "classNameTemplate": 0,
    "fetchInClientEffect": 0,
    "asyncInEffect": 0,
    "derivedStateInEffect": 0,
    "directTanstackImport": 0,
    "localTableOrForm": 1,
    "retiredImport": 0,
    "routeStateSelection": 2,
    "cognitiveComplexity": 0,
    "sonar": 12,
    "codeRules": 942,
    "code/curly": 927,
    "sonarjs/no-nested-assignment": 1,
    "sonarjs/todo-tag": 1,
    "sonarjs/no-redundant-optional": 2,
    "code/max-depth": 7,
    "sonarjs/no-nested-template-literals": 2,
    "sonarjs/no-nested-conditional": 2,
    "sonarjs/no-os-command-from-path": 1,
    "code/no-console": 8,
    "sonarjs/use-type-alias": 1,
    "sonarjs/super-linear-regex": 2,
    "pageTemplate": 38
  }
}
