{
  "name": "@akinaza/db",
  "version": "0.1.0",
  "private": true,
  "description": "Akinaza's PostgreSQL 16 schema (Drizzle, versioned SQL migrations): shops, staff, services, schedules, clients and their Loi 25 consents, appointments (no double booking, by the database), invoices and payments, expenses, the append-only GST/QST ledger that must balance every invoice — tested on a real PostgreSQL.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./roles": "./src/roles.ts",
    "./plaintext-leak": "./src/plaintext-leak.ts",
    "./seed": "./src/seed.ts",
    "./seed-walker": "./src/seed-walker.ts",
    "./demo-clean": "./src/demo-clean.ts",
    "./qa-reset-walker": "./src/qa-reset-walker.ts",
    "./seed-krizaka": "./src/seed-krizaka.ts",
    "./seed-owner-states": "./src/seed-owner-states.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/seed-cli.ts",
    "seed:demos": "tsx src/seed-demos-cli.ts"
  },
  "dependencies": {
    "@akinaza/core": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "@krizaka/api-keys": "0.1.0",
    "@krizaka/auth": "^0.12.0",
    "@krizaka/db": "0.3.0",
    "@krizaka/email-verification": "^0.1.1",
    "@krizaka/intl": "0.3.0",
    "@krizaka/org": "^0.3.1",
    "@krizaka/organize": "0.4.0",
    "@krizaka/privacy": "0.2.0",
    "@krizaka/settings": "0.2.0",
    "@krizaka/ui": "^3.76.1",
    "@krizaka/webhooks": "0.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
