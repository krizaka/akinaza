{
  "name": "akinaza-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Akinaza \u2014 the all-in-one for independent Qu\u00e9bec shops: bookings, Loi 25 client files, bilingual invoices with GST/QST, a tax ledger, the GST/QST return prepared for the merchant.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@akinaza/web",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run check:i18n && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev:check": "turbo run lint typecheck test --filter='...[origin/main]' && vitest run",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:overflow": "node scripts/check-overflow.mjs",
    "seo:check": "node scripts/check-seo-family.mjs --base http://localhost:3000 --host https://www.akinaza.com --types WebSite,SoftwareApplication",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "e2e:walker": "node scripts/e2e-walker.mjs",
    "shots:storefront": "node scripts/shots-storefront.mjs",
    "payments:setup": "krizaka-payments-setup --catalogue payments/catalogue.json"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/i18n": "^0.2.1",
    "playwright-core": "1.64.0",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Krizaka"
}
