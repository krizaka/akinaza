{
  "name": "akinaza-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Akinaza — the all-in-one for independent Québec shops: bookings, Loi 25 client files, bilingual invoices with GST/QST, a tax ledger, the GST/QST return prepared for the merchant.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@akinaza/web",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run check:i18n && ast-grep test --skip-snapshot-tests && krizaka-sg-ratchet && node scripts/deps.mjs",
    "lint:deps": "node scripts/deps.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "test:coverage": "turbo run test --filter='!./apps/mobile' -- --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov && turbo run test --filter='./apps/mobile' && vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev:check": "turbo run lint typecheck test --filter='...[origin/main]' && vitest run",
    "dev:seed": "pnpm --filter @akinaza/web exec tsx scripts/seed-cast.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:perf": "node scripts/check-perf-budgets.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "seo:check": "krizaka-seo-family --base http://localhost:3000 --host https://www.akinaza.com --types WebSite,SoftwareApplication",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "lint:sg": "krizaka-sg-ratchet",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "krizaka-sg-ratchet --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "e2e:walker": "node scripts/e2e-walker.mjs",
    "e2e:composer": "node scripts/e2e-composer.mjs",
    "shots:storefront": "node scripts/shots-storefront.mjs",
    "shots:docs": "SHOTS_DEVICES=desktop SHOTS_SCENES=docs-shop,docs-bookings,docs-invoices,docs-books,docs-data node scripts/shots-storefront.mjs",
    "payments:setup": "krizaka-payments-setup --catalogue infra/payments/catalogue.json"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/a11y-audit": "0.2.0",
    "@krizaka/config": "^0.13.0",
    "@krizaka/i18n": "^0.2.1",
    "@krizaka/page-audit": "0.3.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "^18.7.0",
    "playwright-core": "1.64.0",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Krizaka"
}
